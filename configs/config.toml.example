# =============================================================================
# 御AgentISOlation (Oaiso) configuration file
#
#   Location : ~/.config/codex-dock/config.toml
#   Format   : TOML
#   Purpose  : change the default value of command-line flags so you don't have
#              to repeat them on every command.
#
# Precedence (highest first):
#   1. command-line flag        (e.g. --image)
#   2. documented environment override (runtime / admin client settings)
#   3. repository oaiso.toml (portable run/build settings only)
#   4. this config file
#   5. built-in default
#
# Every key below is OPTIONAL. Delete a line to fall back to the built-in
# default. Lines starting with `#` are comments / disabled examples.
# =============================================================================


# -----------------------------------------------------------------------------
# Global defaults
# -----------------------------------------------------------------------------

# OCI image used for sandbox (worker) containers.   flag: --image / -i
default_image = "codex-dock:latest"

# OCI image used for the auth proxy container.      (proxy build / run)
proxy_image = "codex-dock-proxy:latest"

# Auth-proxy token lifetime, in seconds.               flag: --token-ttl
# Shorter = safer if a token leaks. 1800 = 30 min, 3600 = 1 h.
default_token_ttl = 3600

# Current network commands use dock-net-proxy. The legacy network_name key
# does not change that default. Use proxy run --network for a custom proxy
# network and keep worker/proxy endpoint configuration consistent.

# Default sandbox image template.                      flag: --template / -T
# If set, `oaiso build` and `oaiso run` use this template unless
# overridden by a flag or a section-specific setting.
# Available templates: "plain" (minimal), "pwn" (CTF/RE tools).
# default_template = "plain"

# Whether `oaiso run` rebuilds an existing template-derived image when
# its Dockerfile has changed on disk since the image was built (compares the
# Dockerfile's mtime against the image's build timestamp). Only applies to
# templates with an on-disk Dockerfile (user templates, or built-in ones
# copied in via `make install-templates`) — has no effect on templates that
# only live embedded in the binary. Building if the image is simply missing
# always happens regardless of this setting.
# auto_build = true

# Default interactive shell launched inside the sandbox (the no-agent shell,
# and --shell debug mode).                             flag: --shell-type
#   "bash" (default) | "zsh" (must be installed in the image; the built-in
#   "plain" and "pwn" templates include it)
# default_shell_type = "bash"

# Print extra operational logs by default.             flag: --verbose / -v
verbose = false

# Print debug logs by default.                         flag: --debug
debug = false


# -----------------------------------------------------------------------------
# [run] — defaults specific to `oaiso run`
# -----------------------------------------------------------------------------
[run]

# Private SQLite disk for new regular Kata workers (unreleased).
# auto reserves 512MiB; use an integer 64MiB–8GiB, or off for custom storage.
# agent_state_size = "auto"

# Host-managed Codex/Claude defaults from agent-policies.toml.
# Inspect with: oaiso agent-policy show NAME
# agent_policy = "approve-for-me"

# Agent started by a plain `oaiso run`: shell, codex, or claude.
# Change it with `oaiso default codex` (or `oaiso default codex --local`).
# agent = "shell"

# Worker isolation. Kata is the default; missing Kata/KVM is an error.
# Explicit compatibility mode: runtime = "runc" (no VM isolation).
# Environment overrides: CODEX_DOCK_RUNTIME / CODEX_DOCK_KATA_RUNTIME.
runtime = "kata"
kata_runtime = "io.containerd.kata.v2"

# Built-in or operator-registered Kata budget.          flag: --profile-size
# Operators register additional names with node serve --resource-profiles JSON.
profile_size = "standard"

# Image for `run` only. If unset, the global `default_image` is used.
image = "codex-dock:latest"

# Template for `run` only. If unset, the global `default_template` is used.
# When set, the template's tag is used as the image (e.g. "pwn" → codex-dock:pwn).
# template = "plain"

# Token TTL for `run` only. If unset, the global `default_token_ttl` is used.
token_ttl = 3600

# Auto-rebuild-on-stale-template for `run` only. If unset, the global
# `auto_build` is used.
# auto_build = true

# Shell type for `run` only. If unset, the global `default_shell_type` is used.
# shell_type = "zsh"

# Which user the agent runs as inside the container.   flag: --user
#   current        host user's uid:gid (default)
#   codex          the image's codex user (1001:1001)
#   dir            owner of the project directory
#   ""             image default user
#   <uid>[:<gid>]  explicit, e.g. "1000:1000"
user = "current"

# Codex CLI approval mode.                             flag: --approval-mode
#   suggest | auto-edit | full-auto | danger
approval_mode = "suggest"

# Optional per-user defaults; a repository's oaiso.toml can override
# these portable values, and explicit CLI flags still take priority.
# model = "..."
# read_only = false
# no_internet = false
# egress_allow_domains = ["api.github.com"]  # per-worker general egress allowlist
# policy_preset = "api" # offline, test, dependencies, api (all opt-in)
# deny_read = ["/workspace/.env"]
# deny_write = ["/workspace/config"]
# max_lifetime = "2h"  # requires oaiso reap --watch
# idle_timeout = "30m" # management execution activity, not guest CPU
# protect_main = true # keep a running primary process safe from idle reaping; max_lifetime still applies
# max_requests = 100
# max_concurrent = 2
# max_transfer_bytes = 10485760 # auth-proxy request + response bodies; not general egress
# max_observed_tokens = 50000 # stops new requests after observation; not a prepaid billing cap
# retention = "24h"    # requires oaiso reap --watch; 0 never deletes
# start_hooks = ["npm ci"] # guest shell commands in GLOBAL config
# readiness = "test -d node_modules"
# readiness_timeout = "60s"
# environment_lock = "codex-dock.lock.json"
# ssh_proxy = false
# jvm_proxy = false
# ca_bundle = "/absolute/extra-ca.pem"

# Additional host directories to bind-mount into the worker, beyond
# /workspace (--project).                              flag: --mount
# Each entry: "<host-path>:<container-path>[:ro|rw]" (defaults to rw).
# Ignored when --mount is passed on the command line.
# mounts = ["/home/user/datasets:/data:ro", "./cache:/cache"]


# -----------------------------------------------------------------------------
# [build] — defaults specific to `oaiso build`
# -----------------------------------------------------------------------------
[build]

# Default template for `build`. If unset, the global `default_template` is used.
# template = "plain"

# Default image tag for `build`.                       flag: --tag / -t
# tag = "codex-dock:latest"


# -----------------------------------------------------------------------------
# [proxy]
# Optional data-listener TCP ceilings; unreleased main. Per proxy, not AI request budgets.
# max_connections = 512
# max_connections_per_source = 32
# network_bytes_per_second = 1048576 # combined directions per source IP; 32 KiB burst

# Unreleased main: private fixed-origin broker routes; outside worker shares.
# credential_routes = "/home/alice/.config/codex-dock/broker/routes.json"
 — defaults for the auth proxy / router
#
# The node service enforces worker network isolation. The auth proxy handles
# fixed AI routes with real credentials; a separate credential-free egress
# proxy handles general HTTP/CONNECT traffic. Host setup requires root;
# normal CLI operations use the trusted operator group.
# -----------------------------------------------------------------------------
[proxy]

# Auth Proxy URL reachable from workers (static hosts entry + data-plane
# port).                                               flag: --proxy-container-url
# The legacy key `firewall.proxy_container_url` is still honored for now.
container_url = "http://codex-auth-proxy:18080"

# Host-only admin connection for run / ui / stop / rm. Keep credentials out of
# URLs and worker labels. Environment: CODEX_DOCK_PROXY_ADMIN_SECRET.
# This is a CLIENT setting; configure the server with proxy run --admin-secret.
admin_url = "http://127.0.0.1:18081"
# admin_secret = "your-admin-secret"

# General egress requires an explicit domain or CIDR grant by default.
# Fixed AI routes remain available without general egress.                         flag: --forward-allow-domain
#
# Example: only allow common package registries and source hosts.
# Default deny requires an explicit domain or CIDR grant. Ports alone do not grant destinations.
# Set false explicitly to permit public destinations without grants.
forward_default_deny = true
# Bare domains include subdomains; prefix = for exact match, e.g. "=api.github.com".
# forward_allow_domains = ["github.com", "=registry.npmjs.org", "pypi.org", "files.pythonhosted.org"]

# Denials override allowances. Bare domains include subdomains; =name is exact.
# Nonempty domain/CIDR/port allowlists must ALL match. Default deny changes empty-list behavior above.
# The managed egress proxy always blocks private/LAN/metadata destinations.
# forward_deny_domains = ["blocked.example.com"]
# forward_allow_cidrs = []
# forward_deny_cidrs = ["203.0.113.0/24"]
# forward_allow_ports = [80, 443]
# forward_deny_ports = [25]
# allowed_models = ["model-id"] # exact IDs; opt-in HTTP AI routes only, no WebSocket
# upstream_proxy = "http://proxy.example.com:3128" # verified-IP CONNECT chaining
# ca_bundle = "/absolute/extra-ca.pem" # additional proxy TLS roots
# Changes require proxy recreation; `proxy run` rejects an existing policy
# mismatch. Drain workers first: Kata workers pin the current proxy IPs.

# Local trusted Kata verification service.
[kata]
node_socket = "/run/codex-dock-node.sock"
