# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# CLI binaries
/oaiso
/oaiso-*
/cxd
/codex-dock
/codex-dock-*

# Config with secrets
~/.config/codex-dock/apikey

# MkDocs build output
site/

# Local Kata assets, image archives, build cache and acceptance evidence
.kata-verification/
codex-dock-worker-guard
__pycache__/
*.pyc

# Editor/IDE
# .idea/
# .vscode/

# Matching CLI/node installation bundles
/dist/

# Local SDK build/install artifacts
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/python/dist/
sdk/python/*.egg-info/
